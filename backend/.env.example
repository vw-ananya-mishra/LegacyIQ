# Copy this file to .env in the backend/ folder and fill in the values you have.
# The backend loads .env automatically on startup (see main.py).
#
# --- Cloud LLMaaS (preferred once available) ---
# Any OpenAI-compatible /chat/completions endpoint works here.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Local Ollama (used automatically if LLM_API_KEY is not set) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
