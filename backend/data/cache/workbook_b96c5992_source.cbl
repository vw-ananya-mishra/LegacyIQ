      IDENTIFICATION DIVISION.
      PROGRAM-ID. POLICY001.
      AUTHOR. LEGACY-TEAM.

      ENVIRONMENT DIVISION.
      INPUT-OUTPUT SECTION.
      FILE-CONTROL.
          SELECT POLICY-FILE ASSIGN TO "POLICYDB.DAT"
              ORGANIZATION IS INDEXED
              ACCESS MODE IS DYNAMIC
              RECORD KEY IS POLICY-ID.
          SELECT AUDIT-FILE ASSIGN TO "AUDITLOG.DAT"
              ORGANIZATION IS SEQUENTIAL.

      DATA DIVISION.
      FILE SECTION.
      FD  POLICY-FILE.
      01  POLICY-RECORD.
          05 POLICY-ID          PIC X(10).
          05 CUSTOMER-NAME      PIC X(30).
          05 PREMIUM-AMOUNT     PIC 9(7)V99.
          05 POLICY-STATUS      PIC X(1).

      WORKING-STORAGE SECTION.
      01  WS-CALC-VARS.
          05 WS-BASE-PREMIUM    PIC 9(7)V99 VALUE ZERO.
          05 WS-RISK-FACTOR     PIC 9V99 VALUE ZERO.
          05 WS-FINAL-PREMIUM   PIC 9(7)V99 VALUE ZERO.
          05 WS-DISCOUNT-PCT    PIC 9V99 VALUE ZERO.
      01  WS-EOF-FLAG           PIC X(1) VALUE 'N'.

      PROCEDURE DIVISION.
      1000-MAIN-PARA.
          PERFORM 2000-INIT-PARA.
          PERFORM 3000-CALCULATE-PREMIUM
              UNTIL WS-EOF-FLAG = 'Y'.
          PERFORM 4000-CLEANUP-PARA.
          STOP RUN.

      2000-INIT-PARA.
          OPEN INPUT POLICY-FILE.
          OPEN OUTPUT AUDIT-FILE.
          MOVE 'N' TO WS-EOF-FLAG.

      3000-CALCULATE-PREMIUM.
          READ POLICY-FILE
              AT END MOVE 'Y' TO WS-EOF-FLAG
          END-READ.
          IF WS-EOF-FLAG NOT EQUAL 'Y'
              PERFORM 3100-APPLY-RISK-FACTOR
              IF POLICY-STATUS EQUAL 'P'
                  PERFORM 3200-APPLY-DISCOUNT
              ELSE
                  MOVE WS-BASE-PREMIUM TO WS-FINAL-PREMIUM
              END-IF
              CALL 'AUDITLOG' USING POLICY-ID WS-FINAL-PREMIUM
          END-IF.

      3100-APPLY-RISK-FACTOR.
          EVALUATE TRUE
              WHEN PREMIUM-AMOUNT > 5000
                  MOVE 1.25 TO WS-RISK-FACTOR
              WHEN PREMIUM-AMOUNT > 1000
                  MOVE 1.10 TO WS-RISK-FACTOR
              WHEN OTHER
                  MOVE 1.00 TO WS-RISK-FACTOR
          END-EVALUATE.
          COMPUTE WS-BASE-PREMIUM = PREMIUM-AMOUNT * WS-RISK-FACTOR.

      3200-APPLY-DISCOUNT.
          MOVE 0.10 TO WS-DISCOUNT-PCT.
          COMPUTE WS-FINAL-PREMIUM =
              WS-BASE-PREMIUM - (WS-BASE-PREMIUM * WS-DISCOUNT-PCT).

      4000-CLEANUP-PARA.
          CLOSE POLICY-FILE.
          CLOSE AUDIT-FILE.
